{
  "name": "@endge/nova-ui-kit",
  "type": "module",
  "version": "0.10.17",
  "private": false,
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/nova-ui-kit.js"
    },
    "./vue": {
      "types": "./dist/vue-global-components.d.ts",
      "import": "./dist/nova-ui-kit.js"
    }
  },
  "module": "./dist/nova-ui-kit.js",
  "types": "./dist/index.d.ts",
  "web-types": "./web-types.json",
  "nova": {
    "components": "./nova-components.json"
  },
  "files": [
    "dist",
    "nova-components.json",
    "web-types.json"
  ],
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "dev": "vite build --watch",
    "dev:watch": "vite build --watch",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "lint-check": "eslint . --cache",
    "lint-fix": "eslint . --fix --cache"
  },
  "dependencies": {
    "@endge/nova": "^0.13.6",
    "@endge/utils": "^0.25.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.3.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/language-core": "^3.3.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "10.9.1",
    "rimraf": "^6.0.1",
    "typescript": "~6.0.3",
    "unplugin-dts": "^1.0.3",
    "vite": "^6.1.0",
    "vitest": "^3.2.4",
    "vue": "^3.5.13",
    "vue-tsc": "^3.3.11"
  }
}
